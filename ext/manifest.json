{
  "manifest_version": 3,
  "name": "Convertex",
  "version": "0.2.0",
  "description": "Convertit images, vidéos, audio, documents, PDF, tableurs et archives entre 85 formats, 100 % en local dans Chrome.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Ouvrir le convertisseur",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png" }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self'"
  }
}
